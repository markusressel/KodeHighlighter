import 'dart:async';

abstract class Repository<T> {
  Future<T?> load(int id);
}

class ItemRepository extends Repository<String> {
  final int retries = 3;
  late final String prefix;

  @override
  Future<String?> load(int id) async {
    if (id == 0xFF) return null;
    await Future.delayed(const Duration(milliseconds: 1000));
    final raw = r'raw \n string';
    return '$prefix item ${id + 1} // not a comment $raw';
  }

  int get size => 1;
}
